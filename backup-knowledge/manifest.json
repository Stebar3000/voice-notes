{
  "manifest_version": 3,
  "name": "Backup knowledge",
  "version": "0.3.0",
  "description": "Backup automatico giornaliero della knowledge dei progetti claude.ai su Dropbox, con le cartelle vere.",
  "key": "",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Backup knowledge"
  },
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*"
  ]
}