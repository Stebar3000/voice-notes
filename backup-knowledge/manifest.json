{
  "manifest_version": 3,
  "name": "Mirroring knowledge",
  "version": "1.0.0",
  "description": "Mirroring a due vie tra la knowledge dei progetti claude.ai e Dropbox (/Projects/LLM-Mirroring), solo file di testo.",
  "key": "",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mirroring knowledge"
  },
  "options_page": "options.html",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://api.dropboxapi.com/*",
    "https://content.dropboxapi.com/*"
  ]
}